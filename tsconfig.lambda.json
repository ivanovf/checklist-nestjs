{
    "extends": "./tsconfig.json",
    "compilerOptions": {
      "outDir": "dist-lambda",
      "target": "es2017", // Adjust as needed
      "module": "commonjs",
      "noImplicitAny": true,
      "strict": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*.ts", "lambda.ts"]
  }