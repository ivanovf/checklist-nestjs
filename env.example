# Copy this file to .env.local and run `pnpm db:setup`.
#
# The values below are deliberately complete and workable as-is for purely local
# development — nothing here needs inventing before the service will start. They are
# placeholders, not secrets: every one of them is public in this repository, so none of
# them may ever be reused in a deployed environment.
#
# Note the filename has no leading dot. `.env*` files must stay untracked, so a dot-named
# template could not be committed without carving an exception into that rule.

NODE_ENV=local
PORT=3000

# Database. These same values initialise the local MongoDB container, so the container and
# the application cannot drift apart — see specs/004-local-mongo-compose.
DB_DRIVE=mongodb
DB_HOST=localhost
DB_PORT=27017
DB_NAME=checklist
DB_USER=root
DB_PASS=localdevpassword
DB_ARGS=authMechanism=DEFAULT

# JWT signing secret. Local-only value; a deployed environment supplies its own.
SECRET=local-development-secret-not-for-deployment

# API key for the tank-level endpoint.
TANK_API_KEY=local-development-tank-key

# CORS_ORIGINS is required only in a deployed environment. Left unset locally, every origin
# is permitted, which is what makes browser-based development work without configuration.
